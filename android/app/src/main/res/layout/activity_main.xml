<?xml version="1.0" encoding="utf-8"?>
<!-- App window on Pleos Connect is about 1680 × 1210 dp (mdpi), so 1 sp = 1 px. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF1F6"
    android:orientation="horizontal"
    android:padding="20dp">

    <!-- left: what the car knows about fuel -->
    <LinearLayout
        android:id="@+id/fuelCard"
        android:layout_width="460dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="길목"
            android:textColor="#10285A"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="가까운 주유소 말고, 가는 길에 있는 주유소"
            android:textColor="#6B7280"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fuelPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#10285A"
            android:textSize="104sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fuelL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4B5563"
            android:textSize="24sp" />

        <ai.gilmok.app.FuelBar
            android:id="@+id/fuelBar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SafeRange · 안전하게 갈 수 있는 거리"
            android:textColor="#6B7280"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/safe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0B9B83"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/formula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6B7280"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/toDest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#111827"
            android:textSize="26sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="신호"
            android:textColor="#6B7280"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/demoYellow" style="@style/Chip" android:text="시연 · 여유" />
            <TextView android:id="@+id/demoRed" style="@style/Chip" android:layout_marginStart="10dp" android:text="시연 · 긴급" />
            <TextView android:id="@+id/live" style="@style/Chip" android:layout_marginStart="10dp" android:text="실차" />
        </LinearLayout>
    </LinearLayout>

    <!-- right: route, recommendation, candidates -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/tabFuel" style="@style/Tab" android:text="주유소" />
            <TextView android:id="@+id/tabFood" style="@style/Tab" android:layout_marginStart="10dp" android:text="DT · 음식점" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView android:id="@+id/modeMin" style="@style/Tab" android:text="최소 우회" />
            <TextView android:id="@+id/modeCheap" style="@style/Tab" android:layout_marginStart="10dp" android:text="최저가" />
        </LinearLayout>

        <ai.gilmok.app.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="440dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card"
                android:layout_width="520dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/cardTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cardName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#10285A"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cardDetour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#0B9B83"
                    android:textSize="72sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cardMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4B5563"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/cardPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#111827"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/cardSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#0B9B83"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/add"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#10285A"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
